{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node tools/validate-tilesets.mjs && node tools/mapgen/index.mjs && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "mapgen": "node tools/mapgen/index.mjs",
    "validate:maps": "node tools/mapgen/index.mjs",
    "bake:tilesets": "node tools/bake-tilesets.mjs",
    "convert:webp": "node tools/convert-webp.mjs",
    "validate:tilesets": "node tools/validate-tilesets.mjs",
    "migrate:maps": "node tools/migrate-maps.mjs",
    "test:data": "tsx -e \"import { DataValidator } from './src/data/validation/DataValidator.ts'; DataValidator.validateAll();\"",
    "test:battle": "tsx src/tests/battle.test.ts",
    "test:evolution": "tsx src/tests/evolution.test.ts",
    "test:party": "tsx src/tests/party-management.test.ts",
    "test:gacha": "tsx -e \"import { GachaTestRunner, Bloque28BQrTestRunner } from './src/systems/gacha'; const a = GachaTestRunner.runAllTests(); const b = Bloque28BQrTestRunner.runAllTests(); if (!a.allPassed || !b.allPassed) { console.error('[test:gacha] FALLO', { gacha: a.allPassed, qr: b.allPassed }); process.exit(1); }\"",
    "test:quests": "tsx src/tests/quests.test.ts",
    "test:vfx": "tsx src/tests/vfx.test.ts",
    "test:transition": "tsx src/tests/transition.test.ts",
    "test:all": "npm run test:data && npm run test:battle && npm run test:evolution && npm run test:party && npm run test:gacha && npm run test:quests && npm run test:vfx && npm run test:transition && npm run validate:maps && npm run validate:tilesets",
    "test:e2e": "playwright test",
    "perf:scenarios": "tsx scripts/perf-scenarios.ts",
    "pack:atlas": "tsx scripts/pack-atlas.ts",
    "test:balance": "tsx scripts/simulate-battles.ts",
    "prepare:atlas": "tsx tools/prepare_atlas.ts",
    "prepare:sprites": "tsx tools/generate_souldoll_sheets.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "jpeg-js": "^0.4.4",
    "pixi.js": "^8.21.0",
    "pngjs": "^7.0.0",
    "three": "^0.186.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.14.0",
    "@types/three": "^0.186.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
