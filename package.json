{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node tools/validate-tilesets.mjs && node tools/mapgen/index.mjs && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "mapgen": "node tools/mapgen/index.mjs",
    "validate:maps": "node tools/mapgen/index.mjs",
    "bake:tilesets": "node tools/bake-tilesets.mjs",
    "convert:webp": "node tools/convert-webp.mjs",
    "validate:tilesets": "node tools/validate-tilesets.mjs",
    "migrate:maps": "node tools/migrate-maps.mjs",
    "test:data": "tsx -e \"import { DataValidator } from './src/data/validation/DataValidator.ts'; DataValidator.validateAll();\"",
    "test:battle": "tsx src/tests/battle.test.ts",
    "test:evolution": "tsx src/tests/evolution.test.ts",
    "test:party": "tsx src/tests/party-management.test.ts",
    "test:gacha": "tsx -e \"import { GachaTestRunner, Bloque28BQrTestRunner } from './src/systems/gacha'; GachaTestRunner.runAllTests(); Bloque28BQrTestRunner.runAllTests();\"",
    "test:vfx": "tsx src/tests/vfx.test.ts",
    "test:transition": "tsx src/tests/transition.test.ts",
    "test:all": "npm run test:data && npm run test:battle && npm run test:evolution && npm run test:party && npm run test:gacha && npm run test:vfx && npm run test:transition && npm run validate:maps && npm run validate:tilesets",
    "test:e2e": "playwright test",
    "pack:atlas": "tsx scripts/pack-atlas.ts",
    "test:balance": "tsx scripts/simulate-battles.ts",
    "prepare:atlas": "tsx tools/prepare_atlas.ts",
    "prepare:sprites": "tsx tools/generate_souldoll_sheets.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pixi.js": "^8.21.0",
    "pngjs": "^7.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.186.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
