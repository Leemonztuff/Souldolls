  "npcs": [
    {
      "id": "npc_guide_leo",
      "name": "Guía Leo",
      "paletteId": "hiker",
      "x": 18,
      "y": 4,
      "direction": "down",
      "interactLabel": "Hablar",
      "dialogueLines": [
        "¡Bienvenido a Aldea Marioneta!",
        "Al norte se extiende Ruta Claro, donde las almas errantes resuenan entre la hierba alta.",
        "Recuerda visitar primero el Laboratorio del Maestro Artífice y el Taller de Artífices."
      ]
    },
    {
      "id": "npc_girl_mia",
      "name": "Joven Mía",
      "paletteId": "lass",
      "x": 16,
      "y": 15,
      "direction": "right",
      "interactLabel": "Hablar",
      "dialogueLines": [
        "El agua de la fuente central refleja el ki tranquilo de nuestra aldea.",
        "Si las partes del Cuerpo de tu Souldoll sufren daños, llévala al Taller de Artífices."
      ]
    },
    {
      "id": "npc_prof_roble",
      "name": "Maestro Artífice",
      "paletteId": "professor",
      "x": 31,
      "y": 9,
      "direction": "down",
      "interactLabel": "Hablar",
      "dialogueLines": [
        "¡Ah, joven Soultrainer! Tu ki sin afinidad fija puede armonizar con cualquier alma.",
        "Entra a mi Laboratorio cuando estés listo para vincular tu primera Soul Bottle a un Cuerpo."
      ]
    }
  ]
